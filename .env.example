# Phase 1 (Wisp) — the only key required to run today.
# Free tier: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Claude Agent SDK path for Phase 1 (STUDY_PLAN keeps Gemini as default).
ANTHROPIC_API_KEY=

# Phase 2 (Poltergeist) — LangSmith tracing. Graph runs untraced without these.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ghostwriter

# Phase 4 (Revenant) — Neo4j. Matches docker-compose.yml defaults.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ghostwriter

# Future: E2B sandboxed execution (README limitation #3).
E2B_API_KEY=
