{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test)",
      "Bash(pnpm coverage)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)",
      "Bash(pnpm start)",
      "Bash(pnpm rebuild:*)",
      "Bash(pnpm add:*)",
      "Bash(npx tsc:*)",
      "Bash(node -e:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(docker compose config)",
      "Bash(docker compose ps)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Read(./**/secrets*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)"
    ]
  }
}
